# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build

# attendance data — database, selfies, encryption key. NEVER commit this.
/data/

# local test-run state and reports
/test-run/

# The built agents ARE committed, so a deployment can hand them to employees.
# Rebuild with: npm run build:agent  (Windows only) / npm run build:agent:mac  (Mac only)
/agent/obj/
/agent/bin/*
!/agent/bin/PulseAgent.exe
!/agent/bin/PulseAgent.exe.sha256
!/agent/bin/PulseAgent.dmg
!/agent/bin/PulseAgent.dmg.sha256

# env files
.env*
!.env.example

# misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage
*.tsbuildinfo
next-env.d.ts
.vercel

# scratch scripts
/scripts/_*
