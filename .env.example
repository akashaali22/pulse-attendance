# Copy to .env.local for development, or set these in your hosting provider.

# Where the SQLite database, selfies and the password key are stored.
# Default: ./data  ·  Docker/Fly: /data (a mounted volume — back it up!)
ATTENDANCE_DATA_DIR=./data

# Set to true when the site is served over HTTPS, so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# Company timezone is set in the app (Settings → Company). This only affects server logs.
TZ=Asia/Karachi

# Key that encrypts the admin-viewable copy of passwords (64 hex chars).
# REQUIRED on hosts without a persistent disk — otherwise a new key is generated on every restart
# and stored passwords can no longer be shown. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_KEY=

# Long secret that lets a locked-out admin set a new password from "Forgot password".
# Leave it empty to switch that off; employees can still ask an admin from the same page.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_RECOVERY_CODE=

# Free hosting without a disk (Render free plan): keep the database in a PRIVATE GitHub repo.
# Leave empty when the data directory is on real storage.
BACKUP_REPO=
BACKUP_TOKEN=
BACKUP_INTERVAL_SEC=30

# "1" fills an empty database with a sample company — for a public demo only.
DEMO_MODE=0
